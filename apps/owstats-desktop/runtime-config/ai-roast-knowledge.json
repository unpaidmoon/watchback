    "消耗坦": {"role":"tank","description":"通过中距离压制、资源交换或持续威胁建立空间的坦克。","statExpectations":{"damage":"持续伤害需要结合击杀转化。","healingReceived":"高资源占用应与实际产出一并解释。"}},
    "枪位": {"role":"damage","description":"以稳定直射或远程火力提供持续压力的输出。","statExpectations":{"damage":"通常应提供稳定持续输出。","killsAndFinalHits":"需要判断伤害是否形成击杀转化。","context":"面对空中或暴露目标时通常承担更直接的压力任务。"}},
    "狗位": {"role":"damage","description":"依靠机动、侧翼与收割制造关键目标压力的输出。","statExpectations":{"damage":"总伤害可能低于正面持续输出英雄。","killsAndFinalHits":"击杀参与、收割和关键目标压力更重要。","objectiveTime":"执行侧翼任务时目标时间较低不一定是问题。"}},
    "阵地输出": {"role":"damage","description":"依赖角度、区域或持续阵地压力制造输出的英雄。","statExpectations":{"damage":"高伤害需要结合击杀和最后一击判断有效转化。","deaths":"阵地被反复突破后的高阵亡通常削弱持续压力。"}},
    "治疗型": {"role":"support","description":"主要通过稳定治疗维持队伍续航的支援。","statExpectations":{"healing":"治疗是重要贡献，但领先不自动证明职责全部完成。","deaths":"存活影响持续治疗能力。"}},
