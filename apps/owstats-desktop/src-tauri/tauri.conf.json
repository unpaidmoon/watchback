{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watchback",
  "version": "0.3.0-beta.2",
  "identifier": "local.owstats.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watchback",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: asset: https: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "resources/current-season.json": "current-season.json"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/installer-hooks.nsh",
        "template": "./windows/installer.nsi",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
